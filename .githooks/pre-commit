#!/bin/sh
# ──────────────────────────────────────────────────
#  pre-commit — 提交前只跑「纯扫描 + 秒级」的七项（合计约 10 秒）
#
#  清单的唯一真源：desktop/scripts/lib/gate-plan.mjs 的 PRECOMMIT。
#  本文件故意只做一件事：调用它。
#
#  为什么门槛是「纯扫描」而不是「重不重要」：commit 比 push 频繁一个量级，钩子
#  一旦超过半分钟就会被 --no-verify 绕过，等于没有。纯扫描项不编译、不跑测试树，
#  耗时与代码体量无关，加进提交路径几乎免费：
#      source-size 0.1s（.rs 600 行线）· component-size 0.5s（300 行红线）
#      rust-tempdir 1.1s · tokens 1.4s · fmt 2s · ui-contract 2.2s · tsc 6s（冷 23s）
#  eslint、vitest、clippy、cargo test 全部留给 pre-push / CI（它们要分钟级）。
#
#  🔴 component-size 必须在这一层（2026-11-12 补）：300 行红线以前只在 CI 和
#  「发版跑的完整门禁」里查，v0.5.0 就把一个 309 行的 ResultTable 写完、提交、
#  推主线、发版，全程没人拦，直到手动补 mac 才在 frontend job 里红。红线这种
#  「写的时候就该知道」的事，检查点越靠前越省事——它只要 0.5 秒。
#
#  只改文档的提交会自动跳过（--precommit 按暂存文件后缀挑，并打印跳了哪几项）。
#
#  安装：git config core.hooksPath .githooks
#        （npm install / npm run dev 会自动装，见 scripts/ensure-hooks.mjs）
#  跳过：git commit --no-verify
#        （典型场景：同工作树里别人的半成品把某项弄红了，别去改代码迁就它）
# ──────────────────────────────────────────────────

set -e

# 钩子由 git 从仓库根调用，但 cwd 不保证是仓库根。
cd "$(dirname "$0")/.."

exec node desktop/scripts/gate.mjs --precommit
