dist/
*.blob

# Rust / Tauri
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/src-tauri/binaries/

# OS cruft
.DS_Store
Thumbs.db

# 本地设计稿 / 过程资产（不进模板仓库）
/design/

# 工具临时产物
.codegraph/
.impeccable/
.workbuddy/

