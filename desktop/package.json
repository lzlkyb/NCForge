{
  "name": "nc-forge",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-monaco.mjs",
    "vite:dev": "node scripts/patch-monaco.mjs && vite",
    "vite:build": "node scripts/patch-monaco.mjs && tsc && vite build",
    "test": "vitest run",
    "motion:check": "node --test scripts/check-motion.mjs",
    "test:scripts": "node --test scripts/lib/zip-store.test.mjs",
    "gate:rust": "node scripts/rust-gate.mjs",
    "tauri": "tauri",
    "predev": "node scripts/sync-version.mjs && node scripts/gen-changelog.mjs",
    "dev": "tauri dev",
    "prebuild": "node scripts/sync-version.mjs && node scripts/gen-changelog.mjs",
    "jdtls:fetch": "node scripts/fetch-jdtls.mjs",
    "build": "tauri build",
    "updater:generate": "node scripts/generate-updater-json.mjs",
    "resources:pack": "node scripts/pack-resources.mjs",
    "resources:json": "node scripts/generate-resources-json.mjs",
    "release": "node scripts/release.mjs",
    "lint": "eslint .",
    "lint:prune": "eslint . --prune-suppressions",
    "contract:generate": "node scripts/gen-command-contract.mjs",
    "contract:check": "node scripts/gen-command-contract.mjs --check",
    "orphans:check": "knip --include files,dependencies --no-progress",
    "tokens:check": "node scripts/check-design-tokens.mjs",
    "tokens:update": "node scripts/check-design-tokens.mjs --update",
    "ui:check": "node scripts/check-ui-contract.mjs",
    "ui:update": "node scripts/check-ui-contract.mjs --update",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "bundle:update": "node scripts/check-bundle-size.mjs --update"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@tanstack/react-query": "^5.60.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "monaco-editor": "0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "2.11.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^30.1.3",
    "knip": "^5.88.1",
    "playwright": "^1.49.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
