{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NCForge",
  "mainBinaryName": "nc-forge",
  "version": "0.1.0",
  "identifier": "com.aier.ncforge",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NCForge",
        "width": 1280,
        "height": 840,
        "minWidth": 560,
        "minHeight": 600,
        "decorations": false,
        "visible": false,
        "center": true,
        "resizable": true,
        "backgroundColor": "#F4F6F9"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://lzlkyb.github.io/NCForge/updater.json",
        "https://github.com/lzlkyb/NCForge/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDRkM3MjgzMzdEQjQwNTUKUldSVlFOczNnM0w4VEJYTHZtWnhITy9hcVRsMi9iKzRyQWVtRWxoQjcrM1A3eE40bXJOUHNWcEIK",
      "windows": {},
      "dangerousInsecureTransportProtocol": true,
      "active": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/ecj/ecj-3.17.jar": "ecj/ecj-3.17.jar",
      "resources/jdtls": "jdtls",
      "resources/ncdb/ncdb.jar": "ncdb/ncdb.jar",
      "resources/svnkit/ncsvn.jar": "svnkit/ncsvn.jar",
      "resources/svnkit/svnkit.jar": "svnkit/svnkit.jar",
      "resources/svnkit/trilead.jar": "svnkit/trilead.jar",
      "resources/svnkit/sqljet.1.0.4.jar": "svnkit/sqljet.1.0.4.jar",
      "resources/svnkit/antlr-runtime-3.1.3.jar": "svnkit/antlr-runtime-3.1.3.jar"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
