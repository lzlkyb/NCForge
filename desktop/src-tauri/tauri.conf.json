{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NCForge",
  "mainBinaryName": "nc-forge",
  "version": "0.1.2",
  "identifier": "io.github.lzlkyb.ncforge",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NCForge",
        "width": 1280,
        "height": 840,
        "minWidth": 560,
        "minHeight": 600,
        "decorations": false,
        "visible": false,
        "center": true,
        "resizable": true,
        "backgroundColor": "#F4F6F9"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws: http:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://lzlkyb.github.io/NCForge/updater.json",
        "https://github.com/lzlkyb/NCForge/releases/latest/download/updater.json",
        "https://gitee.com/lzul/NCForge/raw/releases/latest/updater-gitee.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDRkM3MjgzMzdEQjQwNTUKUldSVlFOczNnM0w4VEJYTHZtWnhITy9hcVRsMi9iKzRyQWVtRWxoQjcrM1A3eE40bXJOUHNWcEIK",
      "windows": {},
      "active": true
    },
    "resourcePacks": {
      "_comment": "顺序即故障转移顺序：Release 资产优先，Gitee raw 镜像次之（国内直连 GitHub 慢），gh-pages 垫底（站点当前未启用，404 只是多耗一轮；updater 侧同款端点也是这个状态）。资源 zip 的实际下载 URL 在各自清单里（GitHub 侧走 gh-proxy 镜像，Gitee 侧是 raw 直链）。",
      "endpoints": [
        "https://github.com/lzlkyb/NCForge/releases/latest/download/resources.json",
        "https://gitee.com/lzul/NCForge/raw/releases/latest/resources-gitee.json",
        "https://lzlkyb.github.io/NCForge/resources.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/ncdb/ncdb.jar": "ncdb/ncdb.jar",
      "resources/ecj-bridge/ncecj.jar": "ecj-bridge/ncecj.jar",
      "resources/jdtls-ext/ncforge-jdt-ext.jar": "jdtls-ext/ncforge-jdt-ext.jar"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
